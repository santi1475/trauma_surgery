---
import '../styles/global.css'
// Fuentes self-hosted — eliminan las 3 conexiones render-blocking a Google Fonts.
import '@fontsource-variable/dm-sans'
import '@fontsource-variable/orbitron'
import '@fontsource/dm-mono/400.css'
import '@fontsource/dm-mono/500.css'

// Props opcionales — permiten sobreescribir título y descripción por página.
// Si no se pasan, mantiene los valores por defecto del sitio (HOME).
interface Props {
  title?: string
  description?: string
  image?: string
}

const {
  title = 'TraumaSurgery — Precisión Quirúrgica',
  description = 'TraumaSurgery EIRL — Dispositivos médicos de alta precisión para osteosíntesis y reemplazos articulares. Perú, Bolivia y Colombia.',
  image = '/og.jpg',
} = Astro.props

// `site` se define en astro.config.mjs; si falta, cae al origen de la petición.
const base = Astro.site ?? Astro.url
const canonical = new URL(Astro.url.pathname, base).href
const ogImage = new URL(image, base).href

// Datos estructurados — alimentan el panel de negocio local en búsqueda B2B.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: 'TraumaSurgery EIRL',
  description,
  url: canonical,
  logo: new URL('/ig/logo.webp', base).href,
  image: ogImage,
  email: 'traumasurgery.eirl@gmail.com',
  telephone: '+51998436284',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Pablo Carriquiry N° 460',
    addressLocality: 'San Isidro',
    addressRegion: 'Lima',
    addressCountry: 'PE',
  },
  areaServed: [
    { '@type': 'Country', name: 'Perú' },
    { '@type': 'Country', name: 'Bolivia' },
    { '@type': 'Country', name: 'Colombia' },
    { '@type': 'Country', name: 'Paraguay' },
  ],
  contactPoint: [
    { '@type': 'ContactPoint', telephone: '+51953327198', contactType: 'sales', areaServed: 'PE', availableLanguage: 'es' },
    { '@type': 'ContactPoint', telephone: '+51932527371', contactType: 'customer support', areaServed: 'PE', availableLanguage: 'es' },
  ],
  sameAs: ['https://www.instagram.com/traumasurgeryperu'],
  medicalSpecialty: 'Orthopedic',
}
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#020b18" />

    <!-- Open Graph — WhatsApp y LinkedIn son el canal de difusión B2B real -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TraumaSurgery EIRL" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style is:global>
      /* Wireframe shimmer — solo lo usa el overlay de transición entre páginas. */
      .ts-skel {
        background: linear-gradient(
          90deg,
          rgba(0, 217, 255, 0.05) 0%,
          rgba(0, 217, 255, 0.14) 50%,
          rgba(0, 217, 255, 0.05) 100%
        );
        background-size: 200% 100%;
        animation: ts-skel-shimmer 1.4s linear infinite;
        border-radius: 4px;
      }
      @keyframes ts-skel-shimmer {
        0%   { background-position: 200% 0; }
        100% { background-position: -200% 0; }
      }

      .ts-transition-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: #01070f;
        opacity: 0;
        pointer-events: none;
        transition: opacity 220ms ease;
        display: flex;
        flex-direction: column;
      }
      .ts-transition-overlay.is-visible {
        opacity: 1;
        pointer-events: auto;
      }

      /* Skip-link — solo visible al llegar por teclado. */
      .ts-skip-link {
        position: absolute;
        left: 12px;
        top: -100px;
        z-index: 200;
        padding: 10px 18px;
        background: #00d9ff;
        color: #01070f;
        font-weight: 700;
        border-radius: 6px;
        transition: top 160ms ease;
      }
      .ts-skip-link:focus-visible { top: 12px; }

      @media (prefers-reduced-motion: reduce) {
        .ts-skel { animation: none; background: rgba(0, 217, 255, 0.10); }
        .ts-transition-overlay, .ts-skip-link { transition: none !important; }
      }
    </style>
  </head>
  <body class="m-0 p-0 overflow-x-hidden">
    <a class="ts-skip-link" href="#contenido">Saltar al contenido</a>

    <slot />

    <!--
      Overlay de transición entre páginas internas.
      Render server-side; se muestra al click en links cross-page,
      se oculta automáticamente al cargar la siguiente página.
    -->
    <div
      id="ts-transition-overlay"
      class="ts-transition-overlay"
      aria-hidden="true"
    >
      <!-- Wireframe del Header en transición -->
      <div style="height:76px;padding:18px 60px;border-bottom:1px solid rgba(0,217,255,0.18);display:flex;align-items:center;justify-content:space-between;background:#01070f;">
        <div style="display:flex;align-items:center;gap:10px;">
          <div class="ts-skel" style="width:40px;height:40px;border-radius:9999px;"></div>
          <div class="ts-skel" style="width:140px;height:14px;"></div>
        </div>
        <div style="display:flex;gap:28px;">
          <div class="ts-skel" style="width:60px;height:10px;"></div>
          <div class="ts-skel" style="width:60px;height:10px;"></div>
          <div class="ts-skel" style="width:60px;height:10px;"></div>
          <div class="ts-skel" style="width:60px;height:10px;"></div>
        </div>
        <div class="ts-skel" style="width:96px;height:32px;border-radius:6px;"></div>
      </div>

      <!-- Wireframe del Hero / contenido principal -->
      <div style="flex:1;max-width:1280px;margin:0 auto;width:100%;padding:128px 32px 0;">
        <div class="ts-skel" style="width:120px;height:22px;border-radius:9999px;margin-bottom:24px;"></div>
        <div class="ts-skel" style="width:70%;height:48px;margin-bottom:14px;"></div>
        <div class="ts-skel" style="width:55%;height:48px;margin-bottom:32px;"></div>
        <div class="ts-skel" style="width:90%;max-width:600px;height:14px;margin-bottom:8px;"></div>
        <div class="ts-skel" style="width:80%;max-width:520px;height:14px;margin-bottom:40px;"></div>
        <div class="ts-skel" style="width:96px;height:2px;background:#00d9ff;opacity:.5;"></div>
      </div>
    </div>

    <script is:inline>
      (() => {
        // Overlay de transición entre páginas internas.
        const overlay = document.getElementById('ts-transition-overlay')
        if (!overlay) return

        const isInternalNav = (a) => {
          if (!a || a.target === '_blank' || a.hasAttribute('download')) return false
          const href = a.getAttribute('href')
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return false
          try {
            const url = new URL(a.href, location.href)
            if (url.origin !== location.origin) return false
            if (url.pathname === location.pathname) return false
            return true
          } catch { return false }
        }

        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
          const a = e.target && e.target.closest && e.target.closest('a[href]')
          if (!a || !isInternalNav(a)) return
          overlay.classList.add('is-visible')
        }, true)

        // Reset al volver desde bfcache.
        window.addEventListener('pageshow', () => overlay.classList.remove('is-visible'))
      })()
    </script>
  </body>
</html>
