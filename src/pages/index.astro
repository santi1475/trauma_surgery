---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header'
import Hero from '../components/Hero'
import IngenieriaSinLimites from '../components/IngenieriaSinLimites'
import Soluciones from '../components/Soluciones'
import InfoCards from '../components/InfoCards'
import ProductosSection from '../components/ProductosSection'
import DiagonalGalleryBanner from '../components/DiagonalGalleryBanner'
import GlobalStats from '../components/GlobalStats'
import InstagramFeed from '../components/InstagramFeed'
import Contacto from '../components/Contacto'
import GlobalPresence from '../components/GlobalPresence'
import Footer from '../components/Footer'
---
<Layout>
  <Header client:only="react" />
  <main class="block m-0 p-0">
    <!--
      Skeleton del Hero — SSR, ocupa el viewport mientras React hidrata.
      Se oculta automáticamente cuando <section aria-label="Hero principal"> se monta.
      Reserva espacio exacto: min-h-screen + pt para el Header fixed.
    -->
    <div
      data-skeleton="hero"
      aria-hidden="true"
      class="relative w-full overflow-hidden min-h-screen pt-20 lg:pt-24"
      style="background:#020b18;"
    >
      <div class="absolute inset-0 grid grid-cols-1 lg:grid-cols-2">
        <div class="relative h-full ts-skel" style="border-radius:0;opacity:.4;"></div>
        <div class="relative h-full" style="background:linear-gradient(to right, transparent, #020b18 60%);"></div>
      </div>
      <div class="relative w-full h-full grid grid-cols-1 lg:grid-cols-2 px-6 lg:px-12 xl:px-20" style="min-height: calc(100vh - 5rem);">
        <!-- Columna izquierda — texto -->
        <div class="flex items-center pt-8 lg:pt-0">
          <div class="w-full max-w-[480px] lg:translate-y-6">
            <div class="ts-skel" style="width:90px;height:18px;border-radius:9999px;margin-bottom:20px;"></div>
            <div class="ts-skel" style="width:100%;height:42px;margin-bottom:12px;"></div>
            <div class="ts-skel" style="width:80%;height:42px;margin-bottom:28px;"></div>
            <div class="ts-skel" style="width:100%;height:14px;margin-bottom:8px;"></div>
            <div class="ts-skel" style="width:92%;height:14px;margin-bottom:8px;"></div>
            <div class="ts-skel" style="width:78%;height:14px;margin-bottom:32px;"></div>
            <div style="display:flex;gap:12px;">
              <div class="ts-skel" style="width:140px;height:44px;border-radius:6px;"></div>
              <div class="ts-skel" style="width:140px;height:44px;border-radius:6px;opacity:.6;"></div>
            </div>
          </div>
        </div>
        <!-- Columna derecha — stats + features (desktop) -->
        <div class="hidden lg:flex flex-col items-end justify-center gap-6">
          <div class="w-[230px] flex flex-col gap-3">
            <div class="ts-skel" style="width:100%;height:60px;"></div>
            <div class="ts-skel" style="width:100%;height:60px;"></div>
            <div class="ts-skel" style="width:100%;height:60px;"></div>
          </div>
          <div class="w-[230px] flex flex-col gap-2">
            <div class="ts-skel" style="width:70%;height:10px;"></div>
            <div style="display:flex;gap:8px;">
              <div class="ts-skel" style="width:20px;height:20px;border-radius:9999px;"></div>
              <div class="ts-skel" style="width:20px;height:20px;border-radius:9999px;"></div>
              <div class="ts-skel" style="width:20px;height:20px;border-radius:9999px;"></div>
              <div class="ts-skel" style="width:20px;height:20px;border-radius:9999px;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- S1: Hero slider interactivo (above the fold) -->
    <Hero client:only="react" />
    <!-- S2: Ingeniería Sin Límites (sin WebGL — hidrata al ser visible) -->
    <IngenieriaSinLimites client:visible />
    <!-- S3: Visor 3D interactivo (canvas R3F, defer hasta visible) -->
    <ProductosSection client:visible />
    <!-- S4: Soluciones destacadas -->
    <Soluciones client:visible />
    <!-- S5: Banner Diagonal Gallery -->
    <DiagonalGalleryBanner client:visible />
    <!-- S6: Diferenciales -->
    <InfoCards client:visible />
    <!-- S7: Global Stats -->
    <GlobalStats client:visible />
    <!-- S8: Instagram Feed -->
    <InstagramFeed client:visible />
    <!-- Contacto -->
    <Contacto client:visible />
    <!-- Presencia Global (teaser mapa) -->
    <GlobalPresence client:visible />
  </main>
  <Footer client:visible />
</Layout>
